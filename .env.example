DISCORD_TOKEN=your-bot-token-here

# Speech-to-text (faster-whisper) settings. All optional.
# Model size: tiny, base, small, medium, large-v3. Larger = more accurate, slower, more RAM.
# On CPU, stick to `tiny` or `base` for sub-second latency. `small` roughly
# doubles per-chunk inference time and is hard to keep up with on a CPU host.
WHISPER_MODEL=base
# Device: cpu or cuda
WHISPER_DEVICE=cpu
# Compute type: int8 (CPU), int8_float16 (GPU), float16 (GPU), float32 (anywhere)
WHISPER_COMPUTE_TYPE=int8
# Force a language code (e.g. en, fr, de). Leave empty to auto-detect.
WHISPER_LANGUAGE=
# Initial prompt: biases Whisper's vocabulary. Helpful for code-switching
# (e.g. Spanish with English loanwords), brand names, slang, in-jokes.
# Example for Spanish-with-English-gaming-jargon channels:
#   "Conversación en español con palabras en inglés como gaming, server, lag, push, rush."
WHISPER_INITIAL_PROMPT=
# Voice pipeline self-healing: if no decoded audio arrives for this many seconds
# while humans are in the channel, the bot force-reconnects to recover a stalled
# receive pipeline. Raise it if you get spurious reconnects during quiet periods,
# or set 0 to disable (the connection/listening recoveries still run).
VOICE_STALL_RECONNECT_SECONDS=90

# YouTube music (/play). Requires ffmpeg on PATH (included in Docker images).
# No YouTube API key or Premium key is needed — playback uses yt-dlp search/extract.
# Optional Netscape-format cookies file if YouTube blocks your host IP.
YTDLP_COOKIES_PATH=
MUSIC_MAX_QUEUE=10

# Trigger-word moderation. When any of MUTE_TRIGGER_WORDS appears in a
# transcript (from any speaker), server-mute MUTE_TARGET_USERNAME for
# MUTE_DURATION_SECONDS seconds. Matching is case- and accent-insensitive.
MUTE_TRIGGER_WORDS=
MUTE_TARGET_USERNAME=
MUTE_DURATION_SECONDS=5

# @mention chat. Off by default — no model loaded when false.
CHAT_ENABLED=false
# Backend: llama (local GGUF), ollama_cloud, lmstudio
CHAT_PROVIDER=llama
# Ollama Cloud (CHAT_PROVIDER=ollama_cloud). Create a key at ollama.com/settings/keys
OLLAMA_API_KEY=
CHAT_OLLAMA_MODEL=gpt-oss:120b
# LM Studio (CHAT_PROVIDER=lmstudio). Start the local server in LM Studio first.
CHAT_LMSTUDIO_MODEL=
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# llama.cpp (CHAT_PROVIDER=llama). Optional local GGUF path; if set and the file exists, skips Hugging Face download.
# On first download the bot logs the full path — copy it here for the next run.
CHAT_MODEL_PATH=
CHAT_MODEL_REPO=TheBloke/dolphin-2.6-mistral-7B-GGUF
CHAT_MODEL_FILE=dolphin-2.6-mistral-7b.Q4_K_M.gguf
CHAT_N_CTX=2048
# Layers to offload to the GPU. 0 = CPU only. -1 = all layers (needs the GPU
# image + NVIDIA Container Toolkit). Lower to a positive number if VRAM is tight.
CHAT_N_GPU_LAYERS=0
# Leave empty to use all CPU cores.
CHAT_N_THREADS=
CHAT_MAX_TOKENS=256
CHAT_TEMPERATURE=0.7
CHAT_TOP_P=0.9
CHAT_INFERENCE_TIMEOUT=120
# Role/personality for @mention chat. Edit prompts/personality.txt (recommended).
# CHAT_PERSONALITY_PATH=prompts/personality.txt
# One-line override (wins over the file): CHAT_SYSTEM_PROMPT=
CHAT_PERSONALITY_PATH=
CHAT_SYSTEM_PROMPT=
CHAT_DISABLED_MESSAGE=Chat disabled.
