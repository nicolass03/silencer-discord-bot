DISCORD_TOKEN=your-bot-token-here

# Speech-to-text (faster-whisper) settings. All optional.
# Model size: tiny, base, small, medium, large-v3. Larger = more accurate, slower, more RAM.
# On CPU, stick to `tiny` or `base` for sub-second latency. `small` roughly
# doubles per-chunk inference time and is hard to keep up with on a CPU host.
WHISPER_MODEL=base
# Device: cpu or cuda
WHISPER_DEVICE=cpu
# Compute type: int8 (CPU), int8_float16 (GPU), float16 (GPU), float32 (anywhere)
WHISPER_COMPUTE_TYPE=int8
# Force a language code (e.g. en, fr, de). Leave empty to auto-detect.
WHISPER_LANGUAGE=
# Initial prompt: biases Whisper's vocabulary. Helpful for code-switching
# (e.g. Spanish with English loanwords), brand names, slang, in-jokes.
# Example for Spanish-with-English-gaming-jargon channels:
#   "Conversación en español con palabras en inglés como gaming, server, lag, push, rush."
WHISPER_INITIAL_PROMPT=

# Trigger-word moderation. When any of MUTE_TRIGGER_WORDS appears in a
# transcript (from any speaker), server-mute MUTE_TARGET_USERNAME for
# MUTE_DURATION_SECONDS seconds. Matching is case- and accent-insensitive.
MUTE_TRIGGER_WORDS=
MUTE_TARGET_USERNAME=
MUTE_DURATION_SECONDS=5
