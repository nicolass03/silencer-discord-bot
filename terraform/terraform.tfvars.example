# Copy to terraform.tfvars and fill in secrets. Never commit terraform.tfvars.
#
# cp terraform.tfvars.example terraform.tfvars

aws_region = "us-east-1"

# Required secrets
discord_token  = "your-discord-token-here"
ollama_api_key = "your-ollama-api-key-here"

# Bot configuration (non-secret)
instance_type     = "t3.micro"
ecr_repo_name     = "silencer-discord-bot"
image_tag         = "slim"
memory_limit      = "768m"
chat_ollama_model = "gpt-oss:120b"
music_max_queue   = "10"

# Increment to restart the bot after pushing a new image (without changing env vars)
deploy_revision = 0
