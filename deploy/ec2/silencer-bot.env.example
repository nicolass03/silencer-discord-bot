# Copy to /etc/silencer-bot.env on the EC2 instance.
# sudo install -m 600 silencer-bot.env.example /etc/silencer-bot.env
# sudo nano /etc/silencer-bot.env
#
# Free-tier path: store secrets in this file (no Secrets Manager charges).
# Keep permissions tight: chmod 600, owned by root.

AWS_REGION=us-east-1
# Leave empty to detect from instance credentials:
# AWS_ACCOUNT_ID=

ECR_REPO=silencer-discord-bot
IMAGE_TAG=slim
CONTAINER_NAME=silencer-bot
MEMORY_LIMIT=768m

# Required secrets — replace placeholders:
DISCORD_TOKEN=your-discord-token-here
OLLAMA_API_KEY=your-ollama-api-key-here

# Optional chat tuning:
CHAT_OLLAMA_MODEL=gpt-oss:120b
